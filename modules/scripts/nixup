#!/usr/bin/env bash
set -euo pipefail
# Enhanced Nix update with progress tracking

# Run as your normal user, NOT with sudo: the flake update and build must run as
# the repo owner (nixswitch elevates only the activation step on its own).
if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    echo "❌ Don't run nixup with sudo — run it as your user." >&2
    echo "   It elevates only the activation step on its own." >&2
    exit 1
fi

echo "❄️  Nix Update & Rebuild"
echo "======================="
echo ""

# Navigate to dotfiles
pushd ~/.dotfiles > /dev/null

# The locked commit of an input, read straight out of flake.lock. Taken before
# AND after the update rather than diffed against git: flake.lock is routinely
# dirty from an update that has not been switched yet, so HEAD is not a reliable
# "what we were on" baseline.
locked_rev() { # <input name>
    python3 - "$1" 2>/dev/null <<'PYEOF' || true
import json, sys
try:
    print(json.load(open("flake.lock"))["nodes"][sys.argv[1]]["locked"]["rev"])
except Exception:
    pass
PYEOF
}

dms_rev_before=$(locked_rev dank-material-shell)

# Show current state
echo "📍 Current state:"
if [[ -f flake.lock ]]; then
    last_update=$(date -r flake.lock "+%Y-%m-%d %H:%M" 2>/dev/null || echo "unknown")
    echo "   Last update: $last_update"
fi
echo ""

# Update flake inputs
echo "🔄 [1/3] Updating flake inputs..."
echo "─────────────────────────────────"

if nix flake update 2>&1 | while IFS= read -r line; do
    if [[ "$line" =~ Updated.*input ]]; then
        input=$(echo "$line" | sed -E "s/.*'([^']+)'.*/\1/")
        echo "   ✓ Updated: $input"
    elif [[ "$line" =~ warning ]]; then
        echo "   ⚠ $line"
    fi
done; then
    echo ""
    echo "✅ Flake inputs updated"
else
    echo "❌ Failed to update flake inputs"
    popd > /dev/null
    exit 1
fi
echo ""

# Show what changed
echo "📝 Changes in flake.lock:"
if git diff --quiet -- flake.lock 2>/dev/null; then
    echo "   (no changes)"
else
    git diff --color=always --stat -- flake.lock 2>/dev/null | sed 's/^/   /'
fi
echo ""

# A moved dank-material-shell is the one input change that can quietly cost you
# settings, so it gets called out by name instead of being left to a one-line
# flake.lock stat. The shell ignores any settings key missing from its current
# spec and erases it on the next save (SettingsStore.js parse/toJson), which
# lands at the next login rather than during the switch -- long after you would
# connect it to this update. See modules/scripts/dmssettings.
dms_rev_after=$(locked_rev dank-material-shell)
if [[ -n "$dms_rev_before" && -n "$dms_rev_after" && "$dms_rev_before" != "$dms_rev_after" ]]; then
    echo "🧩 DankMaterialShell moved: ${dms_rev_before:0:7} → ${dms_rev_after:0:7}"

    # The updated input is already realised in the store, so the incoming
    # schema version can be read before anything is built.
    dms_src=$(nix eval --impure --raw \
        --expr '(builtins.getFlake (toString ./.)).inputs.dank-material-shell.outPath' \
        2>/dev/null || true)
    new_ver=""
    if [[ -n "$dms_src" ]]; then
        new_ver=$(grep -oE 'settingsConfigVersion:[[:space:]]*[0-9]+' \
            "$dms_src/quickshell/Common/SettingsData.qml" 2>/dev/null |
            grep -oE '[0-9]+' | head -1 || true)
    fi
    cur_ver=$(python3 -c 'import json,os,sys
p = os.path.expanduser("~/.config/DankMaterialShell/settings.json")
try:
    print(json.load(open(p)).get("configVersion", ""))
except Exception:
    pass' 2>/dev/null || true)

    if [[ -n "$new_ver" && -n "$cur_ver" && "$new_ver" != "$cur_ver" ]]; then
        echo "   ⚠ settings schema v$cur_ver → v$new_ver — migrations will run at your next login"
    elif [[ -n "$new_ver" && -n "$cur_ver" ]]; then
        echo "   settings schema unchanged (v$cur_ver)"
    fi
    echo "   A snapshot is taken before the switch; after your next login run:"
    echo "     dmssettings diff"
    echo ""
fi

# A channel bump is exactly when a pin or patch of ours can become dead weight,
# so check right here instead of trusting anyone to remember. This runs BEFORE
# the build on purpose: an overlay that appends a patch nixpkgs has since adopted
# does not go quietly obsolete, it fails the build with "Reversed (or previously
# applied) patch", naming the package and never the overlay. Reported after the
# build, that verdict only ever arrives on the runs that did not need it.
echo "🧹 [2/3] Checking temporary workarounds..."
echo "──────────────────────────────────────────"
if [[ -x ~/Scripts/nixworkarounds ]]; then
    ~/Scripts/nixworkarounds || true
else
    echo "   (nixworkarounds not installed — skipped)"
fi
echo ""

# Build and switch
echo "🔨 [3/3] Building new configuration..."
echo "─────────────────────────────────────"
# `if` rather than a bare call: under `set -e` a failing nixswitch exits the
# script right here, so the failure branch below was dead code and nixup died
# on the raw nix error without a word of its own.
if ~/Scripts/nixswitch; then
    echo ""
    echo "🎉 Update complete!"
    echo "───────────────────"

    # Show new state. Read off the system profile symlink, not
    # `--list-generations`: that needs root for the profile lock and, failing,
    # would abort this script here under `set -e` (see nixswitch's note).
    new_gen=$(readlink /nix/var/nix/profiles/system 2>/dev/null || true)
    new_gen=${new_gen##*/}
    new_gen=${new_gen#system-}
    new_gen=${new_gen%-link}

    echo "   New generation: #${new_gen:-unknown}"
    echo ""
    echo "✨ Your system is now up to date!"
else
    echo ""
    echo "❌ Build failed. Check errors above."
    echo "   If a package died on an already-applied patch, re-read the"
    echo "   workaround report above — one of our overlays is likely obsolete."
    popd > /dev/null
    exit 1
fi

popd > /dev/null
