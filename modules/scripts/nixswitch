#!/usr/bin/env bash
set -euo pipefail
# Enhanced nixswitch with visual feedback (cross-platform)

# Run this as your normal user, NOT with sudo: the build must run as the repo
# owner (only the activation step below elevates). Running the whole script as
# root makes the build fail on repo/HOME ownership.
if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    echo "❌ Don't run nixswitch with sudo — run it as your user." >&2
    echo "   It elevates only the activation step on its own." >&2
    exit 1
fi

# The generation number, read straight off the system profile symlink rather
# than from `{darwin,nixos}-rebuild --list-generations`. Those go through
# nix-env, which locks /nix/var/nix/profiles/system.lock -- root-owned, so as
# your user the command exits 1 with "Permission denied". Under `set -e` that
# killed this script in the command substitution on the line right after
# "Successfully switched!", which is how a switch that had worked came back to
# nixup as a build failure. The symlink needs no privileges and no nix call.
current_generation() {
    local link
    link=$(readlink /nix/var/nix/profiles/system 2>/dev/null) || return 0
    link=${link##*/}
    link=${link#system-}
    printf '%s' "${link%-link}"
}

# DMS owns ~/.config/DankMaterialShell/settings.json outright -- nothing in this
# repo writes it (see modules/nixos/dms.nix). But dank-material-shell is an
# unpinned github: input, so a rebuild can land a beta shell whose settings
# schema has moved, and keys it no longer recognises are dropped at the next
# login and erased on the first save after that. Snapshot first so the loss is
# diffable instead of invisible: `dmssettings diff` after the next login names
# exactly what went. Never fatal -- a missing snapshot must not block a rebuild.
if [[ -x "$HOME/Scripts/dmssettings" ]]; then
    "$HOME/Scripts/dmssettings" snapshot || true
    echo ""
fi

echo "🔨 Building configuration..."
echo ""

build_start=$(date +%s)

if [[ "$OSTYPE" == "darwin"* ]]; then
    BUILD_TARGET="$HOME/.dotfiles#darwinConfigurations.Stefans-MacBook-Pro.system"
    # nix-darwin now requires system activation to run as root
    SWITCH_CMD="sudo darwin-rebuild switch --flake $HOME/.dotfiles#Stefans-MacBook-Pro"
else
    BUILD_TARGET="$HOME/.dotfiles#nixosConfigurations.stefan.config.system.build.toplevel"
    SWITCH_CMD="sudo nixos-rebuild switch --flake $HOME/.dotfiles#stefan"
fi

if nom build "$BUILD_TARGET" "$@"; then
    build_end=$(date +%s)
    build_time=$((build_end - build_start))

    echo ""
    echo "✅ Build completed in ${build_time}s"
    echo ""
    echo "🔄 Activating configuration..."
    echo ""

    # Activation runs as root, which evaluates the flake from this repo. git
    # refuses to read a repo it doesn't own (libgit2 error 7), so make sure
    # root trusts it once. Idempotent — only adds the entry if missing.
    if ! sudo git config --global --get-all safe.directory 2>/dev/null | grep -qxF "$HOME/.dotfiles"; then
        sudo git config --global --add safe.directory "$HOME/.dotfiles"
    fi

    switch_start=$(date +%s)

    if $SWITCH_CMD "$@"; then
        switch_end=$(date +%s)
        switch_time=$((switch_end - switch_start))

        echo ""
        echo "✨ Successfully switched! (${switch_time}s)"

        # Show new generation
        new_gen=$(current_generation)
        echo "   Generation: #${new_gen:-unknown}"

        total_time=$((build_time + switch_time))
        echo "   Total time: ${total_time}s"
        echo ""
    else
        echo ""
        echo "❌ Failed to activate configuration"
        exit 1
    fi
else
    echo ""
    echo "❌ Build failed"
    exit 1
fi
